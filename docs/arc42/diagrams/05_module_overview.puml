@startuml
title Building Blocks - Module Overview

left to right direction
skinparam componentStyle rectangle

package "byteman_static" {
  [cli.py] as cli
  [generator.py] as gen
  [parser.py] as parser
  [inventory.py] as inventory
  [rules.py] as rules
  [linux_integration.py] as linux
  [runtime_parser.py] as rtparser
  [runtime_monitor.py] as monitor
  [stress_runner.py] as stress
  [stress_report.py] as report
  [model.py / runtime_model.py / stress_model.py] as models
}

package "verification" {
  [fixtures] as fixtures
  [scripts] as scripts
  [reports] as reports
}

package "tests" {
  [pytest suite] as tests
}

cli --> gen
cli --> monitor
cli --> linux
cli --> stress

gen --> parser
gen --> inventory
gen --> rules
gen --> models

monitor --> rtparser
monitor --> models

stress --> gen
stress --> linux
stress --> monitor
stress --> report
stress --> models

tests --> cli
tests --> gen
tests --> monitor
tests --> stress
scripts --> cli
scripts --> fixtures
reports ..> scripts

@enduml

