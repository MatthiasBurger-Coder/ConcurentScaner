@startuml
title Stress Runner Decomposition

left to right direction
skinparam componentStyle rectangle

component "load_stress_scenario" as load
component "StressRunner.run" as run
component "_compile_sources" as compile
component "run_generator" as gen
component "write_linux_startup_script" as startup
component "_prepare_byteman_home" as prep
component "_run_iteration (loop)" as iter
component "RuntimeLogMonitor (thread)" as monitor
component "subprocess.run(app)" as app
component "summarize_iteration_report" as summarize
component "aggregate_stress_results" as aggregate
component "_write_json outputs" as writejson

load --> run : scenario config
run --> compile
run --> gen
run --> startup
run --> prep
run --> iter
iter --> monitor
iter --> app
iter --> summarize
run --> aggregate
run --> writejson

@enduml

